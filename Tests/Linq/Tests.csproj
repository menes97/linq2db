<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\linq2db.TestProjects.props" />

	<PropertyGroup>
		<AssemblyName>linq2db.Tests</AssemblyName>

		<MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\VisualBasic\Tests.VisualBasic.vbproj" />
		<ProjectReference Include="..\..\Source\LinqToDB.Identity\LinqToDB.Identity.csproj" />
	</ItemGroup>

	<!-- the SAP client checks that libadonetHDB has its own version, and no package carries the
	     netfx client, so net462 keeps the matching 2.23.27 natives from Redist -->
	<ItemGroup Condition=" '$(TargetFramework)' == 'net462' ">
		<Reference Include="Sap.Data.Hana.v4.5">
			<HintPath>..\..\Redist\SapHana\v4.5\Sap.Data.Hana.v4.5.dll</HintPath>
		</Reference>
		<None Include="..\..\Redist\SapHana\libadonetHDB.dll" Link="libadonetHDB.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="..\..\Redist\SapHana\libadonetHDB32.dll" Link="libadonetHDB32.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' != 'net462' ">
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<!-- From net11 that framework supplies it, so the Tests-wide pin is pruned and fails a net11-only restore (NU1510). -->
	<ItemGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">
		<PackageReference Remove="System.Security.Cryptography.Pkcs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Sap.Data.Hana.Net.v10.0" Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))" />
	</ItemGroup>

	<ItemGroup>
		<!-- T4 support -->
		<Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />

		<None Update="Extensions\ClickHouseTests.tt" Generator="TextTemplatingFileGenerator" LastGenOutput="ClickHouseTests.generated.cs" />
		<Compile Update="Extensions\ClickHouseTests.generated.cs" DesignTime="True" AutoGen="True" DependentUpon="ClickHouseTests.tt" />

		<None Update="Extensions\MySqlTests.tt" Generator="TextTemplatingFileGenerator" LastGenOutput="MySqlTests.generated.cs" />
		<Compile Update="Extensions\MySqlTests.generated.cs" DesignTime="True" AutoGen="True" DependentUpon="MySqlTests.tt" />

		<None Update="Extensions\PostgreSQLTests.tt" Generator="TextTemplatingFileGenerator" LastGenOutput="PostgreSQLTests.generated.cs" />
		<Compile Update="Extensions\PostgreSQLTests.generated.cs" DesignTime="True" AutoGen="True" DependentUpon="PostgreSQLTests.tt" />

		<None Update="Extensions\OracleTests.tt" Generator="TextTemplatingFileGenerator" LastGenOutput="OracleTests.generated.cs" />
		<Compile Update="Extensions\OracleTests.generated.cs" DesignTime="True" AutoGen="True" DependentUpon="OracleTests.tt" />

		<None Update="Extensions\SqlServerTests.tt" Generator="TextTemplatingFileGenerator" LastGenOutput="SqlServerTests.generated.cs" />
		<Compile Update="Extensions\SqlServerTests.generated.cs" DesignTime="True" AutoGen="True" DependentUpon="SqlServerTests.tt" />

		<None Update="Extensions\SqlCeTests.tt" Generator="TextTemplatingFileGenerator" LastGenOutput="SqlCeTests.generated.cs" />
		<Compile Update="Extensions\SqlCeTests.generated.cs" DesignTime="True" AutoGen="True" DependentUpon="SqlCeTests.tt" />
	</ItemGroup>

	<ItemGroup Condition="'$(Language)'=='C#'">
		<Compile Remove="$(MSBuildThisFileDirectory)/../../Source/Shared/*.cs" />
		<Compile Include="$(MSBuildThisFileDirectory)/../../Source/Shared/JetBrains.Annotations.cs" Link="JetBrains.Annotations.cs" />
		<Compile Include="$(MSBuildThisFileDirectory)/../../Source/LinqToDB.CLI/CommandLine/Commands/QueryExecution/QueryValueFormatter.cs" Link="DataProvider/QueryValueFormatter.cs" Condition="'$(TargetFramework)' != 'net462'" />
	</ItemGroup>

	<!-- Remote tests run with TrustedClient = false: the generated SQL text catalog lets the server accept this
	     assembly's own mappings and constant query text, as it would for a user project. Tests send dynamic text on
	     purpose (L2DB1005), and some templates are refused by design for a format item inside quotes (L2DB1006).
	     Attaching the analyzer for the generator also attaches the shipped rules, which the tests break on purpose
	     (legacy APIs under test) and the bulk severity = error would fail the Release build on. -->
	<PropertyGroup>
		<LinqToDBSqlTextCatalog>true</LinqToDBSqlTextCatalog>
		<NoWarn>$(NoWarn);L2DB1001;L2DB1002;L2DB1003;L2DB1004;L2DB1005;L2DB1006</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Source\LinqToDB.Analyzers\LinqToDB.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<!-- RemoteQueryValidatorTests' marker texts must stay outside this assembly's catalog: those tests expect them rejected -->
		<LinqToDBSqlText Include="SqlText.deny.txt" />
	</ItemGroup>

	<Import Project="..\..\Source\LinqToDB.Analyzers.CodeFixes\build\linq2db.Analyzers.targets" />
</Project>
